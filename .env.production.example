APP_NAME="GNOSIX Building Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gnosix.zion3d.ro
APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Platform administration requires a persistent database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gnosix
DB_USERNAME=
DB_PASSWORD=

# No queue worker is required; all messages use SMTP.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local


# Supply SMTP credentials through Forge Environment, never through Git.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_TIMEOUT=15
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="GNOSIX Building Management"
MAIL_EHLO_DOMAIN=gnosix.zion3d.ro

# Run php artisan gnosix:admin once after migrations.
ADMIN_EMAIL=
ADMIN_PASSWORD=
PASSKEY_RP_ID=gnosix.zion3d.ro
PASSKEY_ORIGIN=https://gnosix.zion3d.ro
